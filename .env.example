# Copy to .env and fill in. Never commit .env.
#
# Leave a variable commented out unless you are setting it. python-dotenv loads
# "KEY=" as an empty string, not as unset, and os.getenv("KEY", default) then
# returns "" instead of the default.

# --- LLM providers (backend/main.py, evals/run_eval.py, scripts/smoke_test.py) ---
OPENAI_API_KEY=
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=
# OPENAI_EMBED_MODEL=

# --- Arize tracing (backend/main.py) ---
# ARIZE_SPACE_ID=
# ARIZE_API_KEY=
# ARIZE_PROJECT_NAME=

# --- Flags (backend/main.py) ---
# TEST_MODE is checked for truthiness: any non-empty value, including "0", enables it.
# TEST_MODE=
# ENABLE_RAG=

# --- Scripts (scripts/gen_transcripts.py) ---
# GEN_MODEL=
