# Copy to .env and fill in. Never commit .env.
#
# Leave a variable commented out unless you are setting it. python-dotenv loads
# "KEY=" as an empty string, not as unset, and os.getenv("KEY", default) then
# returns "" instead of the default.

# --- OpenRouter (backend/main.py, scripts/run_batch.py, scripts/smoke_test.py, scripts/gen_transcripts.py) ---
# Required for any model call. Not needed for scripts/score.py or review/server.py.
# OPENROUTER_API_KEY=
# Classifier model. Default: anthropic/claude-haiku-5.5
# OPENROUTER_MODEL=
# After-call note model. Default: the classifier model.
# NOTE_MODEL=

# --- Optional embedding check (scripts/smoke_test.py only; the pipeline uses no embeddings) ---
# OPENAI_API_KEY=
# OPENAI_EMBED_MODEL=

# --- Transcript generation (scripts/gen_transcripts.py) ---
# Must not be an anthropic/ model (different family from the classifier).
# GEN_MODEL=
